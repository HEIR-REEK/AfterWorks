# AfterWorks — environment template
#
# Copy to `.env.local` for development (`cp .env.example .env.local`). NEVER commit a real value:
# anything that looks like a credential in this file must stay a placeholder.
#
# Two rules this project follows:
#   1. A secret is only ever read on the server (`lib/security.ts` / `lib/security-core.ts`).
#      If a variable starts with NEXT_PUBLIC_ it is in the browser bundle — so no password,
#      roster, token or API key may ever use that prefix. `lib/security.ts` fails the posture check
#      if it finds NEXT_PUBLIC_ADMIN_*.
#   2. Anything that grants access is revocable and expiring: sessions, bypass cookies, KYC links.

# ─── App origin ──────────────────────────────────────────────────────────────
# Used for callbacks (Paystack, Didit), CSP frame-src/connect-src and email links.
# On Render this is inferred from RENDER_EXTERNAL_URL when unset.
APP_URL="https://afterworks.example.com"
NEXT_PUBLIC_APP_URL="https://afterworks.example.com"

# Public hostnames the app will answer for. Requests with any other Host header get 400,
# which blocks cache/host-header poisoning and password-reset-link theft. Comma-separated.
APP_ALLOWED_HOSTS="afterworks.example.com,www.afterworks.example.com"

# Set only behind a proxy that overwrites x-forwarded-for (Render/Vercel/Cloudflare do).
# Leave false if clients can send that header directly — otherwise IP rate limits can be spoofed.
TRUST_PROXY_HEADERS="true"

# Force Secure on cookies even when the request looks like http (set true when TLS ends at a proxy).
FORCE_SECURE_COOKIES="true"

# Support address shown to workers (public by design).
NEXT_PUBLIC_SUPPORT_EMAIL="support@afterworks.example.com"
NEXT_PUBLIC_OPS_EMAIL="ops@afterworks.example.com"

# ─── Firebase (client config) ────────────────────────────────────────────────
# Server-side names; `app/layout.tsx` passes them into the client provider, so no NEXT_PUBLIC_
# prefix is required (both forms are accepted).
FIREBASE_WEB_API_KEY="AIza..."
FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_APP_ID="1:000000000000:web:aaaaaaaaaaaaaaaa"
FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
FIREBASE_MESSAGING_SENDER_ID="000000000000"

# ─── Firebase Admin (server only) ────────────────────────────────────────────
# Local development: a path to the downloaded key.
FIREBASE_SERVICE_ACCOUNT_PATH="./serviceAccountKey.json"
# Deployment: the whole JSON, single line, in one variable (takes precedence).
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ─── Operations console: who gets in ─────────────────────────────────────────
# The roster is the only thing that can grant console access. Env-only on purpose: a
# database-editable allow-list would turn one record write into admin.
ADMIN_EMAILS="operator1@your-staff-domain.com,operator2@your-staff-domain.com"

# Session signing secret — REQUIRED, min 32 chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# With it unset the console fails closed (no session can be minted) rather than using a default key.
ADMIN_SESSION_SECRET=""

# Session lifetime (minutes) and the cache TTLs for role/revocation lookups.
ADMIN_SESSION_TTL_MINUTES="45"
ADMIN_ROLE_CACHE_SECONDS="45"
ADMIN_REVOKE_CACHE_SECONDS="20"

# Record one metadata doc per issued console cookie (jti, email, IP digest, UA, expiry) in the
# server-only admin_sessions collection so Security → Active sessions can list and revoke live
# devices. Holds no token/secret. Set false to disable the listing (revocation still works).
ADMIN_TRACK_SESSIONS="true"

# Passcode. Store a derived verifier, not the password:
#   node scripts/hash-admin-password.mjs        # prompts, prints ADMIN_PASSWORD_SCRYPT=...
ADMIN_PASSWORD_SCRYPT=""
# Legacy fallback (plaintext + salt). Prefer the verifier above; remove once rotated.
ADMIN_PASSWORD=""
ADMIN_PASSWORD_SALT=""

# Brute-force budget: failures per window before an IP and an address are locked.
ADMIN_LOCKOUT_THRESHOLD="5"
ADMIN_LOCKOUT_WINDOW_SECONDS="900"
ADMIN_LOCKOUT_SECONDS="900"
ADMIN_LOGIN_RATE_PER_MINUTE="8"

# Optionally mirror `admin: true` onto the Firebase custom claim of roster accounts, so tooling that
# presents an ID token instead of a session cookie is also recognised.
ADMIN_SYNC_CUSTOM_CLAIM="false"

# ─── Maintenance mode (edge gate) ────────────────────────────────────────────
# The config document (system/maintenance) is the source of truth and is edited from /admin/maintenance.
MAINTENANCE_EDGE_GATE="true"     # 503 + Retry-After at the middleware, not just a client-side check
MAINTENANCE_CACHE_MS="10000"     # how long an edge/Node instance may reuse a snapshot
# Emergency override for when Firestore itself is unusable and the console cannot save. It wins over
# the stored config, is honoured at the edge and in Node, and the console shows it as active.
MAINTENANCE_FORCE=""             # blackout | banner | (empty = use the stored config)
MAINTENANCE_FORCE_UNTIL=""       # optional ISO time; when set, the override lifts itself afterwards
MAINTENANCE_FORCE_MESSAGE=""     # optional replacement copy for the public screen
MAINTENANCE_FORCE_PATHS=""       # optional space/comma list, e.g. "/api/wallet /profile" — gate ONLY these
# Render the outage page from the edge as a static document (no app bundle, no Firestore, no JS).
# Set to false only if you need the React /maintenance route to render instead.
MAINTENANCE_STATIC_SHELL="true"

# ─── Rate limiting for API routes ────────────────────────────────────────────
API_RATE_LIMIT_ENABLED="true"
API_RATE_LIMIT_PER_MINUTE="120"
MIDDLEWARE_RATE_LIMIT="false"    # turn on only when the edge sees raw client traffic
MIDDLEWARE_RATE_LIMIT_PER_MINUTE="300"

# ─── Payments (Paystack) ─────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY="sk_tes…xxxx"
PAYSTACK_WEBHOOK_SECRET=""       # from the Paystack dashboard -> Events -> Webhooks
# Only needed if you re-enable the in-browser popup; the redirect flow does not use it.
# PAYSTACK_PUBLIC_KEY is accepted as an alias: next.config.js forwards it into the client bundle.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_tes…xxxx"
# Training fee. The SERVER computes the amount from these — never from the browser.
# `lib/site.ts` (copy) and `app/api/paystack/initialize` (the charge) read the SAME two names, so an
# advertised price and a charged price cannot drift apart. PAYSTACK_AMOUNT_KES wins when set.
PAYSTACK_TRAINING_AMOUNT="10"       # USD
PAYSTACK_AMOUNT_KES="1300"          # localised price (takes precedence for KES charging)
MIN_WITHDRAWAL_USD="10"
PAYOUT_CLEARING_WINDOW_HOURS="24"
USD_TO_KES_RATE="129"
NEXT_PUBLIC_USD_TO_KES_RATE="129"
PAYSTACK_INIT_RATE_PER_MINUTE="6"
# Webhook signature verification is always on; there is no switch to turn it off.

# ─── Identity verification (Didit) ──────────────────────────────────────────
# The client uses DIDIT_API_URL (default https://verification.didit.me), DIDIT_API_KEY,
# DIDIT_WORKFLOW_ID and DIDIT_WEBHOOK_SECRET. There is no client id/secret pair.
DIDIT_API_URL="https://apx.didit.me"
DIDIT_API_KEY=""
DIDIT_WORKFLOW_ID=""
DIDIT_WEBHOOK_SECRET=""          # REQUIRED in production: unsigned webhooks are rejected

# ─── Firebase Auth reads (console accuracy) ─────────────────────────────────
# The console counts accounts in Firebase Auth as well as profiles in Firestore, so it can report
# "disabled credential", "never signed in" and "profile without an account" honestly. The scan is
# capped so a large project cannot make one dashboard request read 100k accounts.
AUTH_SCAN_CAP="5000"
ADMIN_STATS_CACHE_MS="90000"       # how long /api/admin may reuse an aggregated snapshot
HEALTH_PROBE_CACHE_MS="20000"      # datastore probe TTL for /api/health and /status

# ─── Deployment extras ───────────────────────────────────────────────────────
# Refuse to serve a Host that is not in APP_ALLOWED_HOSTS. Only set false to debug a local proxy —
# with no allow-list configured the check is skipped and /admin/security reports that.
REQUIRE_HOST_ALLOW_LIST="true"
# Set true to keep search engines out of the whole site (staging, pre-launch).
SITE_NO_INDEX="false"
# Shown in the footer and on /api/health so an incident can be tied to a build.
APP_VERSION="0.1.0"
GIT_SHA=""
# Optional label for which region/instance answered; shown on /api/health (AWS_REGION also works).
REGION=""
# 1 = `next build` emits a standalone server bundle (used by Docker; Render builds normally).
NEXT_OUTPUT_STANDALONE="0"
# Firebase config is also accepted with a NEXT_PUBLIC_ prefix (NEXT_PUBLIC_FIREBASE_PROJECT_ID etc.);
# `app/layout.tsx` forwards the server names above to the client provider, so both work.

# ─── Email receipts (EmailJS) ───────────────────────────────────────────────
# Public by EmailJS's design (browser-side SDK), but keep the template ids here so they are not
# hard-coded in application files.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=""
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=""
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=""
