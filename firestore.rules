rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the authenticated user is an administrator
    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.email in ['supportafterworks@gmail.com', 'admin@afterworks.io', 'ericmuturi23@gmail.com'] ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Users: own profile read/write, or admin full read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // KYC records: user can read own; admin can read all; writes are restricted to server-side
    match /kyc_records/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }
    
    // System maintenance configuration
    match /system/{doc} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    
    // Jobs catalog
    match /jobs/{jobId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }
    
    // Worker applications
    match /applications/{appId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Admin audit logs: authenticated admin access
    match /admin_logs/{logId} {
      allow read: if request.auth != null && isAdmin();
      allow write: if request.auth != null;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
