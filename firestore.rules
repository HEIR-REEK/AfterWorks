rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read and write their own profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read their own KYC record; writes are restricted to server-side only
    match /kyc_records/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Admin roster — managed exclusively by the Admin SDK (/api/admin/*).
    // Users may read only their own admin document (to confirm their role).
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Job listings are managed from the admin panel (Admin SDK); workers read.
    match /jobs/{jobId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Applications: workers may create/read their own; all updates happen
    // through the admin API routes (Admin SDK).
    match /applications/{appId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Platform settings (maintenance mode etc.) — read-only for signed-in
    // clients; writes go through /api/admin/maintenance (Admin SDK).
    match /site_config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
