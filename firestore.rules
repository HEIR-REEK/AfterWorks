rules_version = '2';

// ============================================================================
// AfterWorks Firestore security rules (v2 — least privilege, zero client trust)
// ----------------------------------------------------------------------------
// Design contract, and the reason almost every `write` below is `false`:
//
//   1. The browser may READ only its own documents plus public catalogue data.
//   2. The browser may WRITE almost nothing. Anything that matters — role, KYC outcome,
//      wallet balances, job slots, maintenance switch, audit ledger — is written by the
//      Admin SDK inside /api/* routes, which bypass rules. That gives us one validated,
//      rate-limited, audited entry point per mutation instead of five.
//   3. The rules trust no administrator claim, profile label or email list. Console authority
//      is a signed HttpOnly cookie that `/api/admin/*` re-resolves against the server-owned
//      roster/staff collection on every request. (An earlier version trusted a custom claim;
//      minting it from a mutable profile email turned a member profile into a console credential.)
//   4. Self-service profile writes are allowed, but only for non-privileged fields, and an
//      account can never create or promote itself.
//
// Deploy with: firebase deploy --only firestore:rules,firestore:indexes
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity helpers ────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // There is deliberately no `isStaff()` custom-claim helper here. Console operators use the
    // Admin SDK through /api/admin/*, not the browser SDK, and a custom claim minted onto a
    // member account was an escalation path. Every privileged read/write below is server-only.

    // Fields a member may never set or change about their own account. This is the list that
    // used to make "grant yourself admin" and "mark your work as completed" possible from the
    // browser console.
    //
    // `phoneKey` and `referralCode` joined the list with the referral work for one reason each:
    //  • `phoneKey` is the value "one phone number, one account" is enforced against. If a member
    //    could write it, the only field protecting that rule would be the member's own.
    //  • `termsAcceptedAt` / `termsVersion` / `privacyAcceptedAt` are the acceptance record. Its
    //    whole value is that the *server* wrote it at a time the server chose, so a client that
    //    could write it would be fabricating the one document we would ever want to be able to
    //    prove. (`/api/auth/terms` writes it; the sign-up form cannot.)
    function privilegedKeys() {
      return ['role', 'isAdmin', 'kycVerified', 'kycStatus', 'kycVerifiedAt', 'kycRejectedAt',
              'kycOnHoldAt', 'kycProvider', 'kycLevel', 'kycRejectionReason', 'kycFailedChecks',
              // A member may ask for a review but may not date their own request: the console
              // queue orders by this, so a client-writable value would let a member jump it.
              'kycRequestedAt',
              'accountState', 'qualityScore', 'jobsCompleted', 'wallet', 'paidTrainings', 'assessmentPasses',
              'moderationReason', 'deletedAt', 'lastModifiedBy', 'phoneVerified', 'identityHash',
              'emailVerified', 'emailVerifiedAt', 'phoneKey', 'referralCode', 'referralCodeCreatedAt',
              'termsAcceptedAt', 'termsVersion', 'privacyAcceptedAt', 'privacyVersion',
              'termsAcceptedEmail',
              // The display number must move with `phoneKey`. Letting the browser write `phone` on
              // its own let it point at a number another account had already claimed (the server's
              // uniqueness transaction only sees the canonical key).
              'phone', 'phoneCountry'];
    }

    function touchesPrivilegedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedKeys());
    }

    function changesOnlyEmail() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email']);
    }

    function onlySafeKeys(maxKeys) {
      return request.resource.data.keys().size() <= maxKeys;
    }

    // ── Members ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow get: if isSelf(userId);
      // The directory is not browsable: an unauthenticated or ordinary member listing /users
      // previously returned every profile in the system (names, emails, payout numbers).
      allow list: if false;

      // Sign-up bootstrap: an account may create its own document, but only in the inert state.
      allow create: if isSelf(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.isAdmin == false
        && request.resource.data.kycVerified == false
        // A Google sign-up arrives with the address already proven by the provider; email sign-up
        // must start unverified. Nothing else may claim a verified inbox at create time.
        && (request.resource.data.get('emailVerified', false) == false
            || request.auth.token.email_verified == true)
        && request.resource.data.accountState == 'active'
        && request.resource.data.wallet.pendingUsd == 0
        && request.resource.data.wallet.availableUsd == 0
        && request.resource.data.get('wallet', {}).get('payoutHoldUsd', 0) == 0
        && request.resource.data.get('signupBonusGranted', false) == false
        // The profile email is not a free-text label: it is used by support lookups and was once
        // used to mint an admin claim. It must be the address Firebase proved for this token.
        && request.auth.token.email != null
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        // The create rule used to allow fields that the update rule correctly calls privileged.
        // A signup could therefore seed paid-training entitlement, a phone claim, a referral code
        // or a fabricated terms acceptance before the account had done anything.
        && request.resource.data.get('paidTrainings', []).size() == 0
        && request.resource.data.get('assessmentPasses', []).size() == 0
        && request.resource.data.get('phoneKey', '') == ''
        && request.resource.data.get('phone', '') == ''
        && request.resource.data.get('phoneCountry', '') == ''
        && request.resource.data.get('referralCode', '') == ''
        && request.resource.data.get('termsAcceptedAt', null) == null
        && request.resource.data.get('privacyAcceptedAt', null) == null
        // Google sign-up may create the profile with the address already proven by Google.
        && (request.resource.data.get('emailVerifiedAt', null) == null
            || (request.resource.data.get('emailVerified', false) == true
                && request.auth.token.email_verified == true))
        && request.resource.data.get('phoneVerified', false) == false
        && request.resource.data.get('deletedAt', null) == null
        && request.resource.data.get('moderationReason', '') == ''
        && request.resource.data.get('lastModifiedBy', '') == ''
        && request.resource.data.get('identityHash', '') == ''
        && request.resource.data.get('qualityScore', 100) == 100
        && request.resource.data.get('jobsCompleted', 0) == 0
        && request.resource.data.keys().size() <= 40;

      // Profile editing stays client-side (it is the worker's own copy), but privilege and money
      // fields are off-limits, the document cannot be grown without bound, and the inbox must
      // already be proven (`email_verified` on the ID token, set only after the Resend link).
      allow update: if isSelf(userId)
                        && request.auth.token.email_verified == true
                        && !touchesPrivilegedKeys()
                        && onlySafeKeys(90)
                        // The profile email is an identity field. It may stay as it is, or be
                        // changed to the address Firebase has already verified for this token —
                        // never to an arbitrary address that another account/console looks up.
                        // Changing the identity address is allowed only as an email-only write to
                        // the address Firebase has already verified for this token. A profile save
                        // that quietly swaps the email alongside other fields is rejected.
                        && (request.resource.data.email.lower() == resource.data.email.lower()
                            || (request.auth.token.email != null
                                && request.resource.data.email.lower() == request.auth.token.email.lower()
                                && changesOnlyEmail()));
      allow delete: if false;
    }

    // ── Public maintenance notice ────────────────────────────────────────────
    // Readable by anyone, including unauthenticated edge traffic and uptime probes: the middleware
    // gate and the /status page both read this public document. It contains copy and timing only.
    // The bypass roster lives in `system/maintenance_bypass` (denied by the `system/{doc}` rule
    // below) and is read with the Admin SDK only, so member/staff emails are not world-readable.
    match /system/maintenance {
      allow read: if true;
      allow write: if false;
    }

    // Everything else under `system/` (session revocation, internal flags) is server-only.
    match /system/{doc} {
      allow read, write: if false;
    }

    // ── Jobs catalogue ───────────────────────────────────────────────────────
    match /jobs/{jobId} {
      allow read: if signedIn();
      allow write: if false; // via PUT/PATCH/DELETE /api/admin/jobs
    }

    // ── Worker applications ──────────────────────────────────────────────────
    match /applications/{appId} {
      allow get: if signedIn() && resource.data.workerUid == request.auth.uid;
      allow list: if signedIn() && request.query.limit <= 100
                   && request.query.where.queryFilters.size() > 0
                   && request.query.where.queryFilters[0].value == request.auth.uid;
      // Applying is a POST to /api/applications (transaction-checked: KYC, slots, duplicates).
      // QA decisions and withdrawals are equally server-only.
      allow create, update, delete: if false;
    }

    // ── Payments ─────────────────────────────────────────────────────────────
    match /transactions/{txId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false; // written by verified Paystack webhook/callback only
    }

    match /wallet_ledger/{entryId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ── Withdrawal (payout) requests ─────────────────────────────────────────
    // A member may watch their own request move through the queue; nothing about the money is
    // client-writable, because the request *is* the hold on their balance. Creating one is
    // `POST /api/payouts` (KYC + balance + destination + one-at-a-time all re-checked in a
    // transaction), settling one is `/api/admin/payouts`, cancelling is `PATCH /api/payouts`.
    match /payout_requests/{requestId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // One guard document per member (id = uid) proving they have a request in flight. It exists so
    // two taps cannot open two payouts against the same balance; it is written and deleted only
    // inside the payout transactions.
    match /payout_open/{userId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    // ── Referral program (server-only) ─────────────────────────────────────
    // `referral_codes/<CODE>` maps a shared code to the member who owns it, and `referrals/<uid>`
    // records who that member brought in. Both are reachable only through `/api/referrals` and
    // the transaction in `saveMemberProfile`.
    //
    // Clients are denied outright, for two separate reasons:
    //  • `referral_codes` is a directory. Letting a member list it would enumerate every other
    //    member's code, which is the raw material for a referral farm.
    //  • `referrals` holds the $3. It is the credit's *evidence*, and the credit is written by the
    //    same transaction that completes the referred person's profile — a client that could flip
    //    `status` to `qualified` would be marking its own bonus as earned.
    match /referral_codes/{code} {
      allow read, write: if false;
    }

    match /referrals/{referredUid} {
      allow read, write: if false;
    }

    // ── Phone-number claims (server-only) ───────────────────────────────────
    // One document per E.164 number, holding the uid that owns it. This is what makes "one phone
    // number, one account" true under concurrency rather than merely usually true: two members
    // saving a profile with the same number at the same instant both pass the lookup query, and
    // it is this document — written in the same transaction as the profile save — that makes the
    // second one lose. Clients must never be able to claim a number by writing it themselves.
    match /phone_claims/{key} {
      allow read, write: if false;
    }

    // ── Worker notifications ─────────────────────────────────────────────────
    match /notifications/{noteId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      // The only client-side write allowed: marking one's own notification as read.
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create, delete: if false;
    }

    // ── Audit ledger (append-only, server-only) ──────────────────────────────
    // Previously any signed-in user could append *and* delete entries, which made it a suggestion
    // box rather than a ledger.
    match /admin_logs/{logId} {
      allow read: if false;
      allow write: if false;
    }

    // ── Active admin-session metadata (server-only) ──────────────────────────
    // One doc per issued console cookie (jti, email, ip digest, UA, expiry). Written and read
    // exclusively by the Admin SDK from /api/* routes so the Security Centre can list and revoke
    // live sessions. It holds no token or secret, but clients must not read or forge it.
    match /admin_sessions/{sessionId} {
      allow read, write: if false; // via Admin SDK only (session record + revoke endpoints)
    }

    // ── Console staff accounts (server-only) ─────────────────────────────────
    // Owner-created staff logins for the operations console: email + role + scrypt passcode
    // hash. Even staff themselves must never read this collection (it holds credential
    // material); it is reachable only through /api/admin/staff behind the owner guard.
    match /admin_accounts/{email} {
      allow read, write: if false; // via Admin SDK only
    }

    // ── Email-verification tokens (server-only) ──────────────────────────────
    // HMAC payload lives in the link; this collection is the single-use ledger (jti, usedAt).
    match /email_verifications/{jti} {
      allow read, write: if false;
    }

    // ── Password-reset challenges (server-only) ──────────────────────────────
    // One doc per address (id = HMAC of the email) holding an HMAC of the one-time code, the
    // attempt counter and the uid. The code itself exists only in the email. Never client-readable:
    // even the hash would let an offline guess of a 6-digit space.
    match /password_resets/{emailHash} {
      allow read, write: if false;
    }

    // ── External job feed (server-only) ──────────────────────────────────────
    // Adzuna adverts are imported by the owner through /api/admin/external-jobs and read through
    // the public server route. The browser never reads this collection directly: the projection
    // drops upstream ids and links and re-checks the Adzuna redirect before rendering.
    match /external_jobs/{jobId} {
      allow read, write: if false;
    }

    match /system/external_jobs_feed {
      allow read, write: if false;
    }

    // ── Deny by default ──────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
